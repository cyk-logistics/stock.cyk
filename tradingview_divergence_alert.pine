//@version=5
indicator("SET — RSI Divergence + Confirmed Entry + EMA800", shorttitle="DIV Entry")

// ===== Inputs =====
rsiLen      = input.int(14, "RSI Length")
lbL         = input.int(5,  "Pivot Left")
lbR         = input.int(5,  "Pivot Right")
rangeLower  = input.int(5,  "Min bars between pivots")
rangeUpper  = input.int(60, "Max bars between pivots")
osLevel     = input.int(40, "Bull: RSI ต่ำกว่า")
obLevel     = input.int(60, "Bear: RSI สูงกว่า")
confirmLen  = input.int(20, "EMA ยืนยันเข้า")
confirmBars = input.int(8,  "รอยืนยันภายใน N แท่ง")
supportPct  = input.float(2.0, "ระยะใกล้แนวรับ EMA800 (%)")
pullLoPct   = input.float(5.0, "ย่อซื้อ: ต่ำกว่า EMA50 ได้ไม่เกิน (%)")
pullHiPct   = input.float(3.0, "ย่อซื้อ: สูงกว่า EMA50 ได้ไม่เกิน (%)")
volMult     = input.float(1.5, "วอลุ่มหนุน: กี่เท่าของเฉลี่ย 20 วัน")
showPanel   = input.bool(true, "แสดงแผงสรุปสถานะ (มุมขวาบน)")

osc    = ta.rsi(close, rsiLen)
emaC   = ta.ema(close, confirmLen)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
ema800 = ta.ema(close, 800)

hline(70, "OB", color=color.new(color.red, 50))
hline(30, "OS", color=color.new(color.green, 50))
plot(osc, "RSI", color=color.new(color.blue, 0))
bgcolor(osc < 30 ? color.new(color.green, 90) : osc > 70 ? color.new(color.red, 90) : na)

inRange(cond) =>
    bars = ta.barssince(cond)
    rangeLower <= bars and bars <= rangeUpper

// ===== Divergence (setup) =====
plFound = not na(ta.pivotlow(osc, lbL, lbR))
bullDiv = plFound and low[lbR] < ta.valuewhen(plFound, low[lbR], 1) and osc[lbR] > ta.valuewhen(plFound, osc[lbR], 1) and inRange(plFound[1])
phFound = not na(ta.pivothigh(osc, lbL, lbR))
bearDiv = phFound and high[lbR] > ta.valuewhen(phFound, high[lbR], 1) and osc[lbR] < ta.valuewhen(phFound, osc[lbR], 1) and inRange(phFound[1])

// ===== ยืนยันเข้า/ออก (จาก divergence) =====
var int armedB = 0
var int armedS = 0
if bullDiv and osc[lbR] <= osLevel
    armedB := confirmBars
if bearDiv and osc[lbR] >= obLevel
    armedS := confirmBars
buy  = armedB > 0 and ta.crossover(close, emaC)
sell = armedS > 0 and ta.crossunder(close, emaC)
if buy
    armedB := 0
else if armedB > 0
    armedB := armedB - 1
if sell
    armedS := 0
else if armedS > 0
    armedS := armedS - 1

// ===== ย่อซื้อในขาขึ้น (ตรงกับหน้า "เทคนิคสวย" บนเว็บ) =====
// ขาขึ้น (เหนือ EMA200) + ราคาย่อลงมาโซน EMA50 + MACD เพิ่งตัดขึ้น (+ เช็ควอลุ่มหนุนเป็นโบนัส)
[macdLine, macdSig, _] = ta.macd(close, 12, 26, 9)
macdX    = ta.crossover(macdLine, macdSig)
uptrend  = close > ema200
pullZone = close >= ema50 * (1 - pullLoPct / 100) and close <= ema50 * (1 + pullHiPct / 100)
volAvg   = ta.sma(volume, 20)
volBoost = not na(volume) and not na(volAvg[1]) and volAvg[1] > 0 and volume >= volMult * volAvg[1] and close > close[1]
pbBuy    = uptrend and pullZone and macdX

// ===== แนวรับใหญ่ EMA800 =====
near800   = math.abs(close - ema800) / ema800 <= supportPct / 100
atSupport = near800 and not near800[1]   // เพิ่งเข้าโซนแนวรับ (เตือนครั้งเดียว)

// ===== สถานะเทคนิครวม (ตรรกะเดียวกับหน้าเว็บ "เทคนิคสวย") =====
bullConfirm = bullDiv and close > emaC
statusTxt = bearDiv ? "🔴 เลี่ยง" : (bullConfirm or pbBuy) ? "🟢 น่าเข้า" : (bullDiv or pullZone) ? "🟡 ใกล้จุดเข้า" : near800 ? "🟣 ที่แนวรับ" : osc < 35 ? "🔵 Oversold" : "⚪ เฝ้าดู"
statusCol = bearDiv ? color.red : (bullConfirm or pbBuy) ? color.green : (bullDiv or pullZone) ? color.orange : near800 ? color.purple : osc < 35 ? color.blue : color.gray
// อันดับสัญญาณเป็นตัวเลข (ให้ AI/Remix อ่านจาก Data Window ได้): 2=น่าเข้า 1=ใกล้ 0.5=แนวรับ 0.3=oversold 0=เฝ้าดู -1=เลี่ยง
sigRank = bearDiv ? -1.0 : (bullConfirm or pbBuy) ? 2.0 : (bullDiv or pullZone) ? 1.0 : near800 ? 0.5 : osc < 35 ? 0.3 : 0.0

// ===== Plot บนแพเนล RSI =====
plot(plFound ? osc[lbR] : na, "BullLn", offset=-lbR, color = bullDiv ? color.green : color.new(color.white, 100), linewidth=2)
plot(phFound ? osc[lbR] : na, "BearLn", offset=-lbR, color = bearDiv ? color.red   : color.new(color.white, 100), linewidth=2)
plotshape(bullDiv, "Bull setup", style=shape.circle, location=location.absolute, offset=-lbR, color=color.new(color.green, 30), size=size.tiny)
plotshape(bearDiv, "Bear setup", style=shape.circle, location=location.absolute, offset=-lbR, color=color.new(color.red, 30), size=size.tiny)

// ===== Plot บนกราฟราคา =====
plot(emaC,   "Confirm EMA (20)",     color=color.new(color.aqua, 0), force_overlay=true)
plot(ema50,  "EMA50",                color=color.new(color.orange, 0), force_overlay=true)
plot(ema200, "EMA200 (เทรนด์)",      color=color.new(color.blue, 0), force_overlay=true)
plot(ema800, "EMA800 (แนวรับใหญ่)",  color=color.new(color.purple, 0), linewidth=2, force_overlay=true)
plotshape(buy,   "BUY",     style=shape.labelup,    location=location.belowbar, text="BUY",  color=color.lime,   textcolor=color.black, size=size.small, force_overlay=true)
plotshape(sell,  "SELL",    style=shape.labeldown,  location=location.abovebar, text="SELL", color=color.red,    textcolor=color.white, size=size.small, force_overlay=true)
plotshape(pbBuy, "ย่อซื้อ", style=shape.labelup,    location=location.belowbar, text="ย่อซื้อ", color=color.teal, textcolor=color.white, size=size.small, force_overlay=true)
plotshape(atSupport, "At EMA800", style=shape.diamond, location=location.belowbar, color=color.purple, size=size.small, force_overlay=true)

// ===== ค่าตัวเลขใน Data Window (ให้ Remix/AI อ่านสถานะจากกราฟ) =====
plot(sigRank,        "ATLS Signal (2=เข้า/-1=เลี่ยง)", display=display.data_window)
plot(uptrend ? 1 : 0,"Uptrend (1=ขาขึ้น)",            display=display.data_window)
plot((close - ema800) / ema800 * 100, "ระยะจาก EMA800 %", display=display.data_window)
plot(buy       ? 1 : 0, "Buy Signal",   display=display.data_window)
plot(sell      ? 1 : 0, "Sell Signal",  display=display.data_window)
plot(pbBuy     ? 1 : 0, "Dip-Buy",      display=display.data_window)
plot(atSupport ? 1 : 0, "At Support",   display=display.data_window)

// ===== แผงสรุปสถานะ (มุมขวาบน) — ให้มองปราดเดียวรู้ + Remix อ่านสถานะกราฟได้ =====
var table panel = table.new(position.top_right, 2, 7, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)
if showPanel and barstate.islast
    dist800 = (close - ema800) / ema800 * 100
    lblBg = color.new(color.gray, 80)
    table.cell(panel, 0, 0, "ATLS Signal", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 0, syminfo.ticker + " " + timeframe.period, bgcolor=color.new(color.black, 0), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 1, "สถานะ", bgcolor=lblBg, text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 1, statusTxt, bgcolor=color.new(statusCol, 20), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 2, "เทรนด์", bgcolor=lblBg, text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 2, uptrend ? "ขาขึ้น ▲" : "ขาลง ▼", text_color=uptrend ? color.green : color.red, text_size=size.small)
    table.cell(panel, 0, 3, "RSI", bgcolor=lblBg, text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 3, str.tostring(osc, "#") + (osc > 70 ? " ร้อน" : osc < 35 ? " เย็น" : " ปกติ"), text_color=osc > 70 ? color.red : osc < 35 ? color.green : color.gray, text_size=size.small)
    table.cell(panel, 0, 4, "MACD", bgcolor=lblBg, text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 4, macdLine > macdSig ? "ขึ้น ▲" : "ลง ▼", text_color=macdLine > macdSig ? color.green : color.red, text_size=size.small)
    table.cell(panel, 0, 5, "EMA800", bgcolor=lblBg, text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 5, (near800 ? "ที่แนวรับ " : "ห่าง ") + str.tostring(dist800, "+#.#") + "%", text_color=near800 ? color.purple : color.gray, text_size=size.small)
    table.cell(panel, 0, 6, "ย่อซื้อ", bgcolor=lblBg, text_color=color.silver, text_size=size.small)
    table.cell(panel, 1, 6, pbBuy ? "✅ ตอนนี้" : pullZone ? "โซน EMA50" : "—", text_color=pbBuy ? color.green : color.gray, text_size=size.small)

// ===== Discord alerts =====
volTxt  = volBoost ? " + วอลุ่มหนุน 💥" : ""
buyMsg  = '{"content": "🟢 **เข้าซื้อ (ยืนยัน)** ' + syminfo.ticker + ' @ ' + str.tostring(close, format.mintick) + ' | Bull Div + ปิดเหนือ EMA' + str.tostring(confirmLen) + ' | TF ' + timeframe.period + '"}'
sellMsg = '{"content": "🔴 **ออก/ระวัง (ยืนยัน)** ' + syminfo.ticker + ' @ ' + str.tostring(close, format.mintick) + ' | Bear Div + ปิดใต้ EMA' + str.tostring(confirmLen) + ' | TF ' + timeframe.period + '"}'
pbMsg   = '{"content": "🟢 **น่าเข้า (ย่อซื้อในขาขึ้น)** ' + syminfo.ticker + ' @ ' + str.tostring(close, format.mintick) + ' | ย่อโซน EMA50 + MACD ตัดขึ้น' + volTxt + ' | TF ' + timeframe.period + '"}'
supMsg  = '{"content": "🟣 **ถึงแนวรับสำคัญ EMA800** ' + syminfo.ticker + ' @ ' + str.tostring(close, format.mintick) + ' | TF ' + timeframe.period + '"}'
if buy
    alert(buyMsg, alert.freq_once_per_bar_close)
if sell
    alert(sellMsg, alert.freq_once_per_bar_close)
if pbBuy
    alert(pbMsg, alert.freq_once_per_bar_close)
if atSupport
    alert(supMsg, alert.freq_once_per_bar_close)

alertcondition(buy,       "Buy (confirmed)",   "เข้าซื้อยืนยันแล้ว")
alertcondition(sell,      "Sell (confirmed)",  "สัญญาณออกยืนยันแล้ว")
alertcondition(pbBuy,     "Dip-Buy (uptrend)", "ย่อซื้อในขาขึ้น: โซน EMA50 + MACD ตัดขึ้น")
alertcondition(atSupport, "At EMA800 support", "ราคาถึงแนวรับสำคัญ EMA800")
